DATABASE_URL="file:./dev.db"
# Devin: leave empty to run the hub in dry-run mode (shows the request instead of creating a session)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_PLAYBOOK_ID=
ARCADE_REPO=github.com/REPLACE/arcade
# Optional collectors
YOUTUBE_API_KEY=

# Protect the Hub with HTTP Basic auth (recommended anywhere but localhost)
HUB_USER=team
HUB_PASSWORD=

# Deployed Hub (Vercel + Neon): use the pooled Neon connection string and the postgres schema
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
