{
  "expo": {
    "name": "Arcade",
    "slug": "viral-arcade",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "arcade",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.viral.arcade",
      "associatedDomains": [
        "applinks:arcade.example.com"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voice games listen to your singing to steer the game. Audio never leaves your device."
      }
    },
    "android": {
      "package": "com.viral.arcade",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "arcade.example.com",
              "pathPrefix": "/play"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "aabefe4f-6285-46d6-92a6-3b34d098dcbf"
      },
      "links": {
        "webHost": "arcade.example.com",
        "scheme": "arcade"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "alexmancilla",
    "updates": {
      "url": "https://u.expo.dev/aabefe4f-6285-46d6-92a6-3b34d098dcbf",
      "fallbackToCacheTimeout": 0
    }
  }
}
